@page
@model IndexModel

@{
    ViewData["Title"] = "Packages";
    ViewData["SearchQuery"] = Model.Query;
}

@section SearchForm
{
    @* The search query is in a form in the header. The search filters are bindings on this Razor page.
    @* Pass the Razor bindings back up to the header's search form. *@
    @if (Model.PackageType != "any")
    {
        <input type="hidden" name="packageType" value="@Model.PackageType" />
    }

    @if (Model.Framework != "any")
    {
        <input type="hidden" name="framework" value="@Model.Framework" />
    }

    @if (Model.Prerelease != true)
    {
        <input type="hidden" name="prerelease" value="False" />
    }

    @if (Model.SortOrder != SearchSortOrder.Relevance)
    {
        <input type="hidden" name="sortBy" value="@Model.SortOrder.ToQueryValue()" />
    }
}

<div class="search-options d-flex flex-wrap align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center">
        <label class="me-2 mb-0 fw-bold">Package type:</label>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle btn-sm" type="button" id="package-type" data-bs-toggle="dropdown" aria-expanded="false">
                @PackageTypes.GetValueOrDefault(Model.PackageType, "Other")
            </button>
            <ul class="dropdown-menu" aria-labelledby="package-type">
                @foreach (var packageType in PackageTypes)
                {
                    <li><a class="dropdown-item" href="@SearchLink(packageType: packageType.Key, page: 1)">@packageType.Value</a></li>
                }
            </ul>
        </div>
    </div>

    <div class="d-flex align-items-center">
        <label class="me-2 mb-0 fw-bold">Framework:</label>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle btn-sm" type="button" id="framework" data-bs-toggle="dropdown" aria-expanded="false">
                @TargetFrameworks.GetValueOrDefault(Model.Framework, "Other")
            </button>
            <ul class="dropdown-menu" aria-labelledby="framework">
                @foreach (var framework in TargetFrameworks)
                {
                    @if (framework.Key.StartsWith("divider")) { <li><hr class="dropdown-divider"></li> }
                    else if (framework.Key.StartsWith("header")) { <li><h6 class="dropdown-header">@framework.Value</h6></li> }
                    else { <li><a class="dropdown-item" href="@SearchLink(framework: framework.Key, page: 1)">@framework.Value</a></li> }
                }
            </ul>
        </div>
    </div>

    <div class="form-check ms-2">
        <input class="form-check-input" type="checkbox" id="prerelease" @(Model.Prerelease ? "checked='checked'" : "") onclick="window.location.href='@SearchLink(prerelease: !Model.Prerelease, page: 1)'" />
        <label class="form-check-label" for="prerelease">
            Include prerelease
        </label>
    </div>

    <div class="d-flex align-items-center ms-md-auto">
        <label class="me-2 mb-0 fw-bold" for="sort-by">Sort by:</label>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle btn-sm" type="button" id="sort-by" data-bs-toggle="dropdown" aria-expanded="false">
                @SortOrders.GetValueOrDefault(Model.SortOrder, Model.SortOrder.ToQueryValue())
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="sort-by">
                @foreach (var sortOrder in SortOrders)
                {
                    <li><a class="dropdown-item@(sortOrder.Key == Model.SortOrder ? " active" : "")" href="@SearchLink(sortOrder: sortOrder.Key, page: 1)">@sortOrder.Value</a></li>
                }
            </ul>
        </div>
    </div>
</div>

@if (Model.Packages.Count == 0)
{
    <div>
        <h2>Oops, nothing here...</h2>
        <p>
            It looks like there's no package here to see. Take a look below for useful links.
        </p>
        <p><a asp-page="/Upload">Upload a package</a></p>
        <p><a href="https://beersolutions.github.io/BaGest/docs" target="_blank" rel="noopener noreferrer">BaGest documentation</a></p>
        <p><a href="https://github.com/BeerSolutions/BaGest/issues" target="_blank" rel="noopener noreferrer">BaGest issues</a></p>
    </div>
}
else
{
    @foreach (var package in Model.Packages)
    {
        <div class="card search-result mb-3">
            <div class="card-body">
                <div class="d-flex">
                    <div class="me-3 d-none d-md-block" style="flex-shrink: 0;">
                        <img src="@package.IconUrl"
                            class="img-fluid rounded"
                            style="width: 64px; height: 64px; object-fit: contain;"
                            onerror="this.src='@Url.Content("~/_content/BaGest.Web/images/default-package-icon-256x256.png")'"
                            alt="The package icon" />
                    </div>
                    <div class="flex-grow-1">
                        <div>
                            <a asp-page="Package" asp-route-id="@package.PackageId" asp-route-version="@package.Version" class="package-title text-decoration-none">
                                @package.PackageId
                            </a>
                            <span class="ms-2">by: @string.Join(", ", package.Authors)</span>
                        </div>
                        <ul class="info list-unstyled mt-2 mb-2 d-flex flex-wrap">
                            <li><i class="bi bi-download" aria-hidden="true"></i> @package.TotalDownloads.ToMetric() total downloads</li>
                            <li><i class="bi bi-flag" aria-hidden="true"></i> Latest version: @package.Version</li>
                            @if (package.Tags.Any())
                            {
                                <li><i class="bi bi-tag" aria-hidden="true"></i> @string.Join(" ", package.Tags)</li>
                            }
                        </ul>
                        <div>
                            @package.Description
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    var showPreviousLink = Model.PageIndex > 1;
    var showNextLink = Model.Packages.Count >= IndexModel.ResultsPerPage;

    if (showPreviousLink || showNextLink)
    {
        <nav aria-label="Search page navigation">
            <ul class="pagination">
                @if (showPreviousLink)
                {
                    <li class="page-item"><a class="page-link" href="@SearchLink(page:Model.PageIndex - 1)">Previous</a></li>
                }

                @if (showNextLink)
                {
                    <li class="page-item"><a class="page-link" href="@SearchLink(page: Model.PageIndex + 1)">Next</a></li>
                }
            </ul>
        </nav>
    }
}

@functions {
    
    private IReadOnlyDictionary<string, string> PackageTypes { get; } = new Dictionary<string, string>()
    {
        { "any", "Any" },
        { "dependency", "Dependency" },
        { "dotnettool", ".NET tool" },
        { "dotnettemplate", ".NET template" },
    };

    // The orders nuget.org offers on its search page. Other sortBy values still work in links.
    private IReadOnlyDictionary<SearchSortOrder, string> SortOrders { get; } = new Dictionary<SearchSortOrder, string>()
    {
        { SearchSortOrder.Relevance, "Relevance" },
        { SearchSortOrder.TotalDownloadsDescending, "Downloads" },
        { SearchSortOrder.CreatedDescending, "Recently updated" },
    };

    private IReadOnlyDictionary<string, string> TargetFrameworks { get; } = new Dictionary<string, string>()
    {
        { "any", "Any" },

        { "divider1", "-" },
        { "header1", ".NET" },

        { "net10.0", ".NET 10.0" },
        { "net9.0", ".NET 9.0" },
        { "net8.0", ".NET 8.0" },
        { "net7.0", ".NET 7.0" },
        { "net6.0", ".NET 6.0" },
        { "net5.0", ".NET 5.0" },

        { "divider2", "-" },
        { "header2", ".NET Standard" },

        { "netstandard2.1", ".NET Standard 2.1" },
        { "netstandard2.0", ".NET Standard 2.0" },
        { "netstandard1.6", ".NET Standard 1.6" },
        { "netstandard1.5", ".NET Standard 1.5" },
        { "netstandard1.4", ".NET Standard 1.4" },
        { "netstandard1.3", ".NET Standard 1.3" },
        { "netstandard1.2", ".NET Standard 1.2" },
        { "netstandard1.1", ".NET Standard 1.1" },
        { "netstandard1.0", ".NET Standard 1.0" },

        { "divider3", "-" },
        { "header3", ".NET Core" },

        { "netcoreapp3.1", ".NET Core 3.1" },
        { "netcoreapp3.0", ".NET Core 3.0" },
        { "netcoreapp2.2", ".NET Core 2.2" },
        { "netcoreapp2.1", ".NET Core 2.1" },
        { "netcoreapp1.1", ".NET Core 1.1" },
        { "netcoreapp1.0", ".NET Core 1.0" },

        { "divider4", "-" },
        { "header4", ".NET Framework" },

        { "net481", ".NET Framework 4.8.1" },
        { "net48", ".NET Framework 4.8" },
        { "net472", ".NET Framework 4.7.2" },
        { "net471", ".NET Framework 4.7.1" },
        { "net463", ".NET Framework 4.6.3" },
        { "net462", ".NET Framework 4.6.2" },
        { "net461", ".NET Framework 4.6.1" },
        { "net46", ".NET Framework 4.6" },
        { "net452", ".NET Framework 4.5.2" },
        { "net451", ".NET Framework 4.5.1" },
        { "net45", ".NET Framework 4.5" },
        { "net403", ".NET Framework 4.0.3" },
        { "net4", ".NET Framework 4" },
        { "net35", ".NET Framework 3.5" },
        { "net2", ".NET Framework 2" },
        { "net11", ".NET Framework 1.1" },
    };

    private string SearchLink(
        string packageType = null,
        string framework = null,
        bool? prerelease = null,
        SearchSortOrder? sortOrder = null,
        int? page = null)
    {
        packageType = packageType ?? Model.PackageType;
        framework = framework ?? Model.Framework;
        prerelease = prerelease ?? Model.Prerelease;
        sortOrder = sortOrder ?? Model.SortOrder;
        page = page ?? Model.PageIndex;

        if (packageType == "any") packageType = null;
        if (framework == "any") framework = null;
        if (prerelease == true) prerelease = null;
        if (page == 1) page = null;

        return Url.Page("Index", new
        {
            q = Model.Query,
            p = page,
            packageType,
            framework,
            prerelease,
            sortBy = sortOrder == SearchSortOrder.Relevance ? null : sortOrder.Value.ToQueryValue(),
        });
    }
}